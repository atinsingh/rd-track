{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "0.1.0",
  "default_locale": "en",
  "permissions": ["tabs", "nativeMessaging", "alarms", "storage"],
  "incognito": "not_allowed",
  "action": { "default_popup": "popup.html", "default_title": "__MSG_name__", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
