# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgres://rd:rd@localhost:5432/rd_track
PORT=4000
# development | test | production
NODE_ENV=development
# 32 random bytes, base64 (openssl rand -base64 32). Required in production.
APP_ENCRYPTION_KEY=
# Ed25519 private key PEM for signing agent policies (openssl genpkey -algorithm ed25519). Required in production.
POLICY_SIGNING_KEY_PEM=
POLICY_SIGNING_KEY_ID=dev-1
# Admins must use TOTP; set false only for local development.
MFA_REQUIRED_FOR_ADMINS=false
# s3 (default, MinIO/AWS) | local (dev: files served via signed API URLs) | memory (tests)
STORAGE=local
PUBLIC_API_URL=http://localhost:4000
# S3 / MinIO (STORAGE=s3)
S3_BUCKET=rd-track-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=rdtrack
S3_SECRET_ACCESS_KEY=rdtrack-dev-secret
AUTH_RATE_LIMIT_PER_MINUTE=10
