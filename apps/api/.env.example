# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgres://rd:rd@localhost:5432/rd_track
PORT=4000
# development | test | production
NODE_ENV=development
# 32 random bytes, base64 (openssl rand -base64 32). Required in production.
APP_ENCRYPTION_KEY=
# Ed25519 private key PEM for signing agent policies (openssl genpkey -algorithm ed25519). Required in production.
POLICY_SIGNING_KEY_PEM=
POLICY_SIGNING_KEY_ID=dev-1
# Admins must use TOTP; set false only for local development.
MFA_REQUIRED_FOR_ADMINS=false
# s3 (default, MinIO/AWS) | local (dev: files served via signed API URLs) | memory (tests)
STORAGE=local
PUBLIC_API_URL=http://localhost:4000
# S3 / MinIO (STORAGE=s3)
S3_BUCKET=rd-track-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=rdtrack
S3_SECRET_ACCESS_KEY=rdtrack-dev-secret
AUTH_RATE_LIMIT_PER_MINUTE=10
# Web app URL used in emails and billing redirects
PUBLIC_WEB_URL=http://localhost:3000
# Agent installers offered under My computers (empty: "not published yet").
# AGENT_DOWNLOAD_BASE_URL=https://github.com/<org>/<repo>/releases/download/agent-v0.1.0
# AGENT_VERSION=0.1.0
# console (dev: prints emails) | ses (production)
EMAIL_PROVIDER=console
EMAIL_FROM="RoundDigital Track <no-reply@track.example>"
# manual (invoiced/dev: plan changes apply immediately) | stripe
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-seat prices created in the Stripe dashboard, one per plan and term.
# Month to month: recurring monthly, $5 Standard / $10 Pro.
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
# Annual term: recurring yearly, $30 Standard / $60 Pro per seat per year ($2.50 / $5 a month).
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
