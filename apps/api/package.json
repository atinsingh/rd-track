{
  "name": "@rd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "esbuild src/main.ts src/worker.ts src/db/migrate-cli.ts src/cli/create-platform-admin.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --external:fastify --external:@fastify/* --external:pg --external:@aws-sdk/* --external:zod && rm -rf dist/migrations dist/db/migrations && cp -r src/db/migrations dist/migrations && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:migrate": "node dist/db/migrate-cli.js",
    "platform:create-admin": "tsx src/cli/create-platform-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/client-sesv2": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@rd/contracts": "workspace:*",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
