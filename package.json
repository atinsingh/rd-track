{
  "name": "rd-track",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:api": "pnpm --filter @rd/api dev",
    "dev:worker": "pnpm --filter @rd/api dev:worker",
    "dev:web": "pnpm --filter @rd/web dev",
    "db:migrate": "pnpm --filter @rd/api db:migrate",
    "db:seed": "pnpm --filter @rd/api db:seed"
  }
}
